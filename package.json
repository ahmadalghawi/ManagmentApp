{
  "name": "income-manager",
  "version": "0.1.0",
  "description": "MeM - Manage Me. Personal finance and time management desktop app.",
  "author": "MeM",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 54321",
    "build": "next build",
    "start": "next start -p 54321",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:54321 && electron .\"",
    "electron:build": "npm rebuild better-sqlite3 && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.mem.manageme",
    "productName": "MeM",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*"
    ],
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "src/**/*",
      "database/**/*",
      "next.config.mjs",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "wait-on": "^9.0.4"
  }
}
